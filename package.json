{
  "name": "weave-epub-reader",
  "private": true,
  "version": "0.7.50",
  "description": "Standalone EPUB reader with bookshelf, deep links, and reading state persistence.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-watch.cjs",
    "kill:vite": "node scripts/kill-vite.cjs",
    "prebuild": "node scripts/clean-cache.cjs --src-js-residue --apply && node scripts/kill-vite.cjs",
    "build": "node scripts/check-mojibake.cjs && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --mode production",
    "postbuild": "node scripts/copy-manifest.cjs && node scripts/verify-release-assets.cjs",
    "verify:release": "node scripts/verify-release-assets.cjs",
    "verify:public-repo": "node scripts/verify-public-repo-safety.cjs",
    "postinstall": "node scripts/patch-foliate-paginator.mjs",
    "i18n:export-keys": "tsx scripts/export-i18n-keys.ts",
    "i18n:validate": "tsx scripts/i18n-validate.ts",
    "i18n:build-overlays": "tsx scripts/export-zh-snapshot.ts && python scripts/build-quality-overlays.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/clean-cache.cjs --src-js-residue --fail-on-find && pnpm run build && pnpm run check:bundle-footprint && node scripts/verify-plugin-scope.cjs",
    "check:bundle-footprint": "node scripts/check-bundle-footprint.cjs",
    "format": "node scripts/run-biome.cjs format",
    "format:check": "node scripts/run-biome.cjs format:check",
    "lint": "node scripts/run-biome.cjs lint",
    "lint:check": "node scripts/run-biome.cjs lint:check",
    "lint:obsidian": "node scripts/run-obsidian-lint.cjs",
    "lint:obsidian:strict": "node scripts/lint-obsidian-strict.cjs",
    "lint:obsidian:community": "node scripts/lint-community-audit.cjs",
    "verify:obsidian-community": "pnpm run lint:obsidian && pnpm run lint:obsidian:strict",
    "verify:community": "pnpm run verify:obsidian-community && pnpm run lint:obsidian:community && pnpm test && pnpm run build",
    "sync:obsidian-version": "node scripts/sync-obsidian-community-version.cjs",
    "lint:svelte5": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rimraf dist && node scripts/clean-cache.cjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "epub",
    "reader",
    "bookshelf",
    "annotations",
    "svelte",
    "svelte5",
    "typescript"
  ],
  "author": "Weave Team",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@biomejs/biome": "1.3.3",
    "@codemirror/autocomplete": "6.18.6",
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.1",
    "@eslint/js": "9.30.1",
    "@eslint/json": "0.14.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/svelte": "5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@unocss/extractor-svelte": "^0.57.2",
    "@vitest/coverage-v8": "^1.3.1",
    "bun-types": "1.3.11",
    "eslint": "9.39.1",
    "eslint-plugin-obsidianmd": "0.4.1",
    "fast-check": "4.5.3",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "obsidian": "^1.4.11",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "tsx": "4.20.6",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.57.2",
    "unocss": "^0.57.2",
    "vite": "^5.0.0",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.9.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/search": "6.5.11",
    "@codemirror/theme-one-dark": "6.1.3",
    "@floating-ui/dom": "1.7.4",
    "foliate-js": "1.0.1",
    "jszip": "3.10.1",
    "nunjucks": "3.2.4",
    "pako": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4"
    },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
